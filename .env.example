APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Platform PayMongo test account used by shop-plan checkout and hosted demo checkout.
OCR_SPACE_API_KEY=

# Texting customers when their laundry is ready, for every shop: textbee or philsms.
SMS_DRIVER=textbee

# PhilSMS (philsms.com): copy the API token from the PhilSMS dashboard (Developers).
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=PhilSMS

# TextBee (textbee.dev): texts customers when their laundry is ready, for every shop.
# Install the TextBee app on one Android phone with a SIM, then copy the API key from the dashboard.
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=

# Thesis demo credentials that shops can enter without creating PayMongo accounts.
# These aliases use the platform test account above and never charge real money.
PAYMONGO_DEMO_ENABLED=true
PAYMONGO_DEMO_SECRET_KEY=sk_test_demoLaundryHubPanel2026
PAYMONGO_DEMO_PUBLIC_KEY=pk_test_demoLaundryHubPanel2026


# Backups (see config/backup.php). Point BACKUP_DISK at an off-server disk such as s3.
BACKUP_DISK=local
# BACKUP_MYSQLDUMP_PATH=/usr/bin/mysqldump
# BACKUP_MYSQL_PATH=/usr/bin/mysql
BACKUP_KEEP_WEEKLY=4
BACKUP_KEEP_MONTHLY=3

# Mapbox (maps, geocoding, routing). VITE_MAPBOX_TOKEN is the public pk. token used in the browser.
# MAPBOX_SECRET_TOKEN is optional; when empty the server proxy reuses the public token.
VITE_MAPBOX_TOKEN=
MAPBOX_SECRET_TOKEN=

# Web Push (driver job alerts). Generate with: php artisan webpush:vapid
VAPID_SUBJECT=mailto:admin@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
